# Staging / UAT environment variables sample
# Copy this to your Vercel / CI environment and fill in real values for staging.

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://your-staging.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret  # optional but recommended
SUPABASE_SERVICE_ROLE=service-role-key  # optional if needed for cron/migrations
SENTRY_DSN=your_sentry_dsn  # optional
